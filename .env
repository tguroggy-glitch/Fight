USER_PHONE=

# ==== Behaviour ====
SESSION_NAME=vcbot
DB_PATH=bot.db
DOWNLOAD_DIR=downloads
AUTO_START_CALL=true
AUTO_LEAVE_EMPTY=true
MAX_UPLOAD_MB=200

# ==== Premium emoji ====
# Enable premium emoji rendering via <tg-emoji> tags.
PREMIUM_EMOJI=true